{
  "_version": 9,
  "_說明": "每個引擎可同時有 cli 與 api 兩種接法，角色的 mode 決定用哪一種。cli.promptVia 為 stdin 時提示詞從標準輸入送入（跨平台最穩，Windows 也不會因換行或引號出錯）；為 arg 時把 args 裡的 {prompt} 換成提示詞。角色有填 model 時會加上 modelArgs。API 的 defaultModel 若為空，請到各家官方文件查目前模型 ID 後填入，或在角色設定直接填 model。 args 裡可放 {modelArgs} 指定模型參數插入位置，沒放就接在最後。 cli.env 可設定執行該 CLI 時額外的環境變數。 permArgs 依角色的「權限」加上對應參數：read 唯讀、workspace 可改工作目錄、full 完整權限（可在整台電腦執行任何指令）。args 裡的 {permArgs} 是插入位置，沒放就接在最後。「改版」流程至少會用 workspace。",
  "claude": {
    "label": "Claude",
    "color": "#d97757",
    "cli": {
      "command": "claude",
      "args": [
        "-p",
        "{permArgs}"
      ],
      "promptVia": "stdin",
      "modelArgs": [
        "--model",
        "{model}"
      ],
      "install": "irm https://claude.ai/install.ps1 | iex",
      "quotaHint": "Claude 方案用量有時間窗限制，請等額度重置後再試。",
      "permArgs": {
        "read": [],
        "workspace": [
          "--permission-mode",
          "acceptEdits"
        ],
        "full": [
          "--dangerously-skip-permissions"
        ]
      }
    },
    "api": {
      "provider": "anthropic",
      "defaultModel": "claude-sonnet-5-5",
      "keyEnv": "ANTHROPIC_API_KEY"
    }
  },
  "codex": {
    "label": "Codex",
    "color": "#10a37f",
    "cli": {
      "command": "codex",
      "args": [
        "exec",
        "--skip-git-repo-check",
        "{modelArgs}",
        "{permArgs}",
        "-"
      ],
      "promptVia": "stdin",
      "modelArgs": [
        "-m",
        "{model}"
      ],
      "install": "npm install -g @openai/codex",
      "quotaHint": "ChatGPT 方案的 Codex 用量有時間窗限制，請等額度重置，或到 ChatGPT 設定查看用量。",
      "permArgs": {
        "read": [
          "--sandbox",
          "read-only"
        ],
        "workspace": [
          "--sandbox",
          "workspace-write"
        ],
        "full": [
          "--dangerously-bypass-approvals-and-sandbox"
        ]
      }
    },
    "api": {
      "provider": "openai",
      "defaultModel": "",
      "keyEnv": "OPENAI_API_KEY"
    }
  },
  "gemini": {
    "label": "Gemini",
    "color": "#4285f4",
    "cli": {
      "command": "agy",
      "args": [
        "-p",
        "{prompt}",
        "{modelArgs}",
        "{permArgs}",
        "--print-timeout",
        "10m"
      ],
      "promptVia": "arg",
      "modelArgs": [
        "--model",
        "{model}"
      ],
      "install": "irm https://antigravity.google/cli/install.ps1 | iex",
      "quotaHint": "Antigravity 的用量依你的 Google AI 方案而定，請等額度重置，或到 Google 帳號查看方案用量。",
      "_註": "Google 已於 2026-06 停止 Gemini CLI 的個人帳號登入，改用 Antigravity CLI（agy）。",
      "permArgs": {
        "read": [],
        "workspace": [
          "--mode",
          "accept-edits"
        ],
        "full": [
          "--dangerously-skip-permissions"
        ]
      }
    },
    "api": {
      "provider": "gemini",
      "defaultModel": "",
      "keyEnv": "GEMINI_API_KEY"
    }
  },
  "grok": {
    "label": "Grok",
    "color": "#9aa0a6",
    "cli": null,
    "api": {
      "provider": "xai",
      "defaultModel": "grok-4.5",
      "keyEnv": "XAI_API_KEY",
      "pricing": {
        "input": 2,
        "output": 6,
        "_單位": "美元／每百萬 token"
      }
    }
  }
}
